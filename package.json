{
  "name": "branca-rs",
  "version": "0.3.2",
  "description": "Branca tokens (IETF XChaCha20-Poly1305, base62) for JavaScript and TypeScript, powered by a Rust core compiled to WebAssembly",
  "keywords": [
    "aead",
    "base62",
    "branca",
    "poly1305",
    "rust",
    "tanstack-intent",
    "token",
    "wasm",
    "webassembly",
    "xchacha20"
  ],
  "homepage": "https://github.com/Gomah/branca-rs#readme",
  "bugs": {
    "url": "https://github.com/Gomah/branca-rs/issues"
  },
  "license": "MIT",
  "author": "Thomas Marrec <thomas@distributed.sh>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gomah/branca-rs.git"
  },
  "files": [
    "dist",
    "skills",
    "!skills/sync-state.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "default": "./dist/init.js"
    },
    "./branca.wasm": "./dist/branca_bg.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:wasm && tsdown",
    "build:wasm": "bun scripts/build-wasm.ts",
    "test": "bun test",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt": "oxfmt && cargo fmt --all",
    "fmt:check": "oxfmt --check && cargo fmt --all --check",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./branca.wasm",
    "skills:check": "bun scripts/skills.ts check",
    "skills:stamp": "bun scripts/skills.ts stamp",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs && bun scripts/smoke.mjs && bun scripts/smoke.cjs",
    "bench": "bun bench/branca.bench.ts",
    "bench:node": "node bench/branca.bench.ts",
    "bench:report": "bun bench/report.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/skills.ts version",
    "release": "changeset publish",
    "prepublishOnly": "bun run build && bun run check:package && bun run skills:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@tanstack/intent": "0.5.6",
    "@types/bun": "1.4.4",
    "binaryen": "132.0.0",
    "branca": "0.5.0",
    "libsodium-wrappers": "0.8.4",
    "mitata": "1.0.34",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "unrun": "0.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
